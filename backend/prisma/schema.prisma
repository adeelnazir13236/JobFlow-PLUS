generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id               Int        @id @default(autoincrement())
  name             String
  email            String     @unique
  password         String
  role             UserRole   @default(STAFF)
  status           String     @default("ACTIVE")
  assignedJobs     Job[]      @relation("AgentJobs")
  staffJobs        Job[]      @relation("StaffJobs")
  callLogs         CallLog[]
  createdCustomers Customer[] @relation("CustomerCreatedBy")
  updatedCustomers Customer[] @relation("CustomerUpdatedBy")
  createdJobs      Job[]      @relation("JobCreatedBy")
  updatedJobs      Job[]      @relation("JobUpdatedBy")
  completedJobs    Job[]      @relation("JobCompletedBy")
  createdPayments  Payment[]  @relation("PaymentCreatedBy")
  updatedPayments  Payment[]  @relation("PaymentUpdatedBy")
  createdCallLogs  CallLog[]  @relation("CallLogCreatedBy")
  updatedCallLogs  CallLog[]  @relation("CallLogUpdatedBy")
  createdFollowUps FollowUp[] @relation("FollowUpCreatedBy")
  updatedFollowUps FollowUp[] @relation("FollowUpUpdatedBy")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Customer {
  id               Int              @id @default(autoincrement())
  name             String
  phone            String
  whatsapp         String?
  email            String?
  address          String?
  area             String?
  city             String?
  jobPaymentAmount Decimal          @default(0) @db.Decimal(12, 2)
  notes            String?          @db.Text
  status           String           @default("ACTIVE")
  createdById      Int?
  updatedById      Int?
  systems          CustomerSystem[]
  jobs             Job[]
  payments         Payment[]
  callLogs         CallLog[]
  followUps        FollowUp[]
  createdBy        User?            @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?            @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([phone])
  @@index([city])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
}

model CustomerSystem {
  id               Int      @id @default(autoincrement())
  customerId       Int
  systemType       String
  systemSize       String?
  numberOfPanels   Int?
  installationType String?
  notes            String?  @db.Text
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Job {
  id              Int        @id @default(autoincrement())
  customerId      Int
  assignedAgentId Int?
  assignedStaffId Int?
  scheduledDate   DateTime
  scheduledTime   String
  status          JobStatus  @default(SCHEDULED)
  completionDate  DateTime?
  remarks         String?    @db.Text
  createdById     Int?
  updatedById     Int?
  completedById   Int?
  customer        Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent   User?      @relation("AgentJobs", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedStaff   User?      @relation("StaffJobs", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy       User?      @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?      @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completedBy     User?      @relation("JobCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  payments        Payment[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([assignedStaffId])
  @@index([scheduledDate])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@index([completedById])
}

model Payment {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  customerId    Int
  jobId         Int           @unique
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  paymentDate   DateTime?
  remarks       String?       @db.Text
  createdById   Int?
  updatedById   Int?
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?         @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([jobId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([createdById])
  @@index([updatedById])
}

model CallLog {
  id           Int          @id @default(autoincrement())
  customerId   Int
  agentId      Int?
  response     CallResponse
  notes        String?      @db.Text
  nextCallDate DateTime?
  createdById  Int?
  updatedById  Int?
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agent        User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CallLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?        @relation("CallLogUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([customerId])
  @@index([agentId])
  @@index([response])
  @@index([nextCallDate])
  @@index([createdById])
  @@index([updatedById])
}

model FollowUp {
  id           Int            @id @default(autoincrement())
  customerId   Int
  jobId        Int?
  followUpDate DateTime
  status       FollowUpStatus @default(PENDING)
  notes        String?        @db.Text
  createdById  Int?
  updatedById  Int?
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job          Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?          @relation("FollowUpUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([customerId])
  @@index([jobId])
  @@index([followUpDate])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
}

enum UserRole {
  ADMIN
  AGENT
  STAFF
}

enum JobStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum CallResponse {
  INTERESTED
  NOT_INTERESTED
  CALL_LATER
  WRONG_NUMBER
  NO_ANSWER
}

enum FollowUpStatus {
  PENDING
  DONE
  SKIPPED
}

enum PaymentStatus {
  PENDING
  PARTIAL_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  JAZZCASH
  EASYPAISA
  OTHER
}
