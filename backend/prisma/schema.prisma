generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id               Int           @id @default(autoincrement())
  organizationId   Int?          @map("organization_id")
  name             String
  email            String        @unique
  password         String
  role             UserRole      @default(STAFF)
  status           String        @default("ACTIVE")
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedJobs     Job[]         @relation("AgentJobs")
  staffJobs        Job[]         @relation("StaffJobs")
  callLogs         CallLog[]
  createdCustomers Customer[]    @relation("CustomerCreatedBy")
  updatedCustomers Customer[]    @relation("CustomerUpdatedBy")
  createdJobs      Job[]         @relation("JobCreatedBy")
  updatedJobs      Job[]         @relation("JobUpdatedBy")
  completedJobs    Job[]         @relation("JobCompletedBy")
  createdPayments  Payment[]     @relation("PaymentCreatedBy")
  updatedPayments  Payment[]     @relation("PaymentUpdatedBy")
  createdCallLogs  CallLog[]     @relation("CallLogCreatedBy")
  updatedCallLogs  CallLog[]     @relation("CallLogUpdatedBy")
  createdFollowUps FollowUp[]    @relation("FollowUpCreatedBy")
  updatedFollowUps FollowUp[]    @relation("FollowUpUpdatedBy")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId])
}

model Organization {
  id              Int              @id @default(autoincrement())
  name            String
  email           String?
  phone           String?
  address         String?
  status          String           @default("ACTIVE")
  plan            String           @default("FREE")
  users           User[]
  customers       Customer[]
  customerSystems CustomerSystem[]
  jobs            Job[]
  payments        Payment[]
  callLogs        CallLog[]
  followUps       FollowUp[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("organizations")
}

model Customer {
  id               Int              @id @default(autoincrement())
  organizationId   Int              @map("organization_id")
  name             String
  phone            String
  whatsapp         String?
  email            String?
  address          String?
  area             String?
  city             String?
  jobPaymentAmount Decimal          @default(0) @db.Decimal(12, 2)
  notes            String?          @db.Text
  status           String           @default("ACTIVE")
  createdById      Int?
  updatedById      Int?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  systems          CustomerSystem[]
  jobs             Job[]
  payments         Payment[]
  callLogs         CallLog[]
  followUps        FollowUp[]
  createdBy        User?            @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?            @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([phone])
  @@index([organizationId])
  @@index([city])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
}

model CustomerSystem {
  id               Int          @id @default(autoincrement())
  organizationId   Int          @map("organization_id")
  customerId       Int
  systemType       String
  systemSize       String?
  numberOfPanels   Int?
  installationType String?
  notes            String?      @db.Text
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
}

model Job {
  id              Int          @id @default(autoincrement())
  organizationId  Int          @map("organization_id")
  customerId      Int
  assignedAgentId Int?
  assignedStaffId Int?
  scheduledDate   DateTime
  scheduledTime   String
  status          JobStatus    @default(SCHEDULED)
  completionDate  DateTime?
  remarks         String?      @db.Text
  createdById     Int?
  updatedById     Int?
  completedById   Int?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent   User?        @relation("AgentJobs", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedStaff   User?        @relation("StaffJobs", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy       User?        @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?        @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  completedBy     User?        @relation("JobCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  payments        Payment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([assignedAgentId])
  @@index([assignedStaffId])
  @@index([scheduledDate])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
  @@index([completedById])
}

model Payment {
  id             Int           @id @default(autoincrement())
  organizationId Int           @map("organization_id")
  invoiceNumber  String        @unique
  customerId     Int
  jobId          Int           @unique
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount  Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentDate    DateTime?
  remarks        String?       @db.Text
  createdById    Int?
  updatedById    Int?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job            Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdBy      User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([jobId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([createdById])
  @@index([updatedById])
}

model CallLog {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  customerId     Int
  agentId        Int?
  response       CallResponse
  notes          String?      @db.Text
  nextCallDate   DateTime?
  createdById    Int?
  updatedById    Int?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agent          User?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("CallLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?        @relation("CallLogUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([agentId])
  @@index([response])
  @@index([nextCallDate])
  @@index([createdById])
  @@index([updatedById])
}

model FollowUp {
  id             Int            @id @default(autoincrement())
  organizationId Int            @map("organization_id")
  customerId     Int
  jobId          Int?
  followUpDate   DateTime
  status         FollowUpStatus @default(PENDING)
  notes          String?        @db.Text
  createdById    Int?
  updatedById    Int?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job            Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?          @relation("FollowUpUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([jobId])
  @@index([followUpDate])
  @@index([status])
  @@index([createdById])
  @@index([updatedById])
}

enum UserRole {
  SYSTEM_ADMIN
  ADMIN
  AGENT
  STAFF
}

enum JobStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum CallResponse {
  INTERESTED
  NOT_INTERESTED
  CALL_LATER
  WRONG_NUMBER
  NO_ANSWER
}

enum FollowUpStatus {
  PENDING
  DONE
  SKIPPED
}

enum PaymentStatus {
  PENDING
  PARTIAL_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  JAZZCASH
  EASYPAISA
  OTHER
}
